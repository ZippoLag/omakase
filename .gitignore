node_modules/
dist/
# kanji.db park-out during `pnpm run deploy:web` (scripts/deploy-web.mjs)
.deploy-tmp/
# wrangler's local state — miniflare's simulated R2 bucket keeps a full 308 MB
# copy of the dictionary after a local `pages dev` / `--local` run: never commit
.wrangler/
# local Cloudflare credentials for `pnpm run deploy:web` (wrangler reads these)
.env
.dev.vars
data/raw/
# per-build version counter (scripts/version.mjs)
.build-number
*.tgz
.DS_Store
web/.certs/
# temporary working plans — local scaffolding, never commit (their headers say so
# and AGENTS.md §9 rule 12 has them deleted when their last item lands:
# REVIEW-FIXES W18, THESAURUS-PLAN P3). Keeping them ignored stops `git add -A`
# from sweeping them into a release commit.
REVIEW-FIXES.md
THESAURUS-PLAN.md
