{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "outDir": "dist"
  },
  "include": [
    "web/**/*.ts",
    "src/kana.ts",
    "src/kangxi.ts",
    "src/conjugation.ts",
    "src/format.ts",
    "src/lookup.ts",
    "src/version.ts"
  ]
}
